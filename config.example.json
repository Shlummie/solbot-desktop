{
  "executionMode": "dry-run",
  "rpc": {
    "primary": "https://api.devnet.solana.com",
    "fallbacks": []
  },
  "mainWalletPath": "./wallets/main.json",
  "walletsDir": "./wallets",
  "funding": {
    "minSol": 0.01,
    "maxSol": 0.02,
    "minRentBufferSol": 0.002
  },
  "trade": {
    "tokens": [],
    "slippageBpsDefault": 100,
    "orderSizing": {
      "unit": "SOL",
      "min": 0.001,
      "max": 0.002
    },
    "priorityFee": {
      "strategy": "adaptive",
      "maxMicroLamports": 10000
    }
  },
  "limits": {
    "maxConcurrent": 2,
    "qpsPerRpc": 4,
    "jitterMs": {
      "min": 500,
      "max": 1500
    },
    "cycleMs": 5000
  },
  "logging": {
    "level": "info",
    "json": true
  },
  "storage": {
    "keyFormat": "solana-keygen-json",
    "encryption": "off"
  }
}
